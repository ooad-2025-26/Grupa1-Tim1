@model IEnumerable<gosarajevovol3.Models.Hospitality>

@{
    ViewData["Title"] = ViewBag.CategoryName;
}

<style>
    .hospitality-page {
        margin-top: 90px;
        padding-bottom: 50px;
    }

    .category-header {
        background-color: #9bb8c6;
        color: white;
        padding: 18px 26px;
        font-weight: 700;
        font-size: 16px;
        margin-bottom: 35px;
    }

        .category-header a {
            color: white;
            text-decoration: none;
        }

            .category-header a:hover {
                text-decoration: underline;
            }

    .places-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 48px 70px;
    }

    .place-card {
        text-align: center;
        text-decoration: none;
        color: #111;
        display: block;
    }

        .place-card:hover {
            color: #111;
        }

        .place-card img {
            width: 100%;
            height: 160px;
            object-fit: cover;
            border-radius: 0;
            margin-bottom: 10px;
            transition: transform 0.2s ease;
        }

        .place-card:hover img {
            transform: scale(1.03);
        }

        .place-card h5 {
            font-weight: 800;
            font-size: 18px;
            margin-bottom: 2px;
        }

        .place-card p {
            font-size: 16px;
            font-style: italic;
            margin: 0;
        }

    .no-items {
        text-align: center;
        font-size: 18px;
        color: #777;
        margin-top: 50px;
    }

    @@media (max-width: 992px) {
        .places-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 576px) {
        .places-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="hospitality-page">

    <div class="category-header">
        <a asp-action="Index">Things To Do</a> &lt; @ViewBag.CategoryName
    </div>

    <div class="container">
        @if (Model.Any())
        {
            <div class="places-grid">
                @foreach (var item in Model)
                {
                    <a asp-action="HospitalityDetails"
                           asp-route-id="@item.Id"
                           class="place-card">

                        @if (!string.IsNullOrEmpty(item.PhotoUrl))
                        {
                            <img src="@item.PhotoUrl"
                                 alt="@item.HospitalityName" />
                        }
                        else
                        {
                            <div style="height:160px; background-color:#ccc; display:flex; align-items:center; justify-content:center;">
                                <span class="text-muted">Nema slike</span>
                            </div>
                        }

                        <h5>@item.HospitalityName</h5>
                        <p>@item.LocationAddress</p>
                    </a>
                }
            </div>
        }
        else
        {
            <p class="no-items">Nema objekata u ovoj kategoriji.</p>
        }
    </div>

</div>