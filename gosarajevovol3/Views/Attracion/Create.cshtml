@model gosarajevovol3.Models.Attraction

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Attraction</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="AttractionName" class="control-label"></label>
                <input asp-for="AttractionName" class="form-control" />
                <span asp-validation-for="AttractionName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AttractionDescription" class="control-label"></label>
                <input asp-for="AttractionDescription" class="form-control" />
                <span asp-validation-for="AttractionDescription" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PhotoUrl" class="control-label"></label>
                <input asp-for="PhotoUrl" class="form-control" />
                <span asp-validation-for="PhotoUrl" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AttractionType" class="control-label"></label>
                <select asp-for="AttractionType" class="form-control"></select>
                <span asp-validation-for="AttractionType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CoordinatesId" class="control-label"></label>
                <select asp-for="CoordinatesId" class ="form-control" asp-items="ViewBag.CoordinatesId"></select>
            </div>
            <div class="form-group">
                <label asp-for="LocationAddress" class="control-label"></label>
                <input asp-for="LocationAddress" class="form-control" />
                <span asp-validation-for="LocationAddress" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
