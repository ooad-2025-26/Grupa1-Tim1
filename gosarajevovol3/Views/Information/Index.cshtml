<script>
    const transportSections = ["tram", "bus", "trolley", "taxi", "rent", "other"];

    const sectionMap = {
        tram: "tram-section",
        bus: "bus-section",
        trolley: "trolley-section",
        taxi: "taxi-section",
        rent: "rent-section",
        other: "other-section",
        emergency: "emergency-section",
        healthcare: "healthcare-section",
        useful: "useful-section"
    };

    function getAllDynamicSections() {
        return document.querySelectorAll(".transport-display, .dynamic-info-section");
    }

    function hideAllDynamicSections() {
        getAllDynamicSections().forEach(function (section) {
            section.classList.add("hidden-section");
        });
        var modesHeading = document.getElementById("modes-heading");
        if (modesHeading) modesHeading.classList.add("hidden-section");
    }

    function showModesHeading() {
        var modesHeading = document.getElementById("modes-heading");
        if (modesHeading) modesHeading.classList.remove("hidden-section");
    }

    function showAllDynamicSections() {
        showModesHeading();
        getAllDynamicSections().forEach(function (section) {
            section.classList.remove("hidden-section");
        });
    }

    function showSelectedSection(sectionKey, sectionId) {
        // Prikaži sve sekcije
        showAllDynamicSections();

        var selectedSection = document.getElementById(sectionId);
        if (selectedSection) {
            setTimeout(function () {
                selectedSection.scrollIntoView({ behavior: "smooth", block: "start" });
            }, 150);
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        var params = new URLSearchParams(window.location.search);
        var section = params.get("section");

        if (!section) {
            showAllDynamicSections();
            return;
        }

        var sectionId = sectionMap[section];
        if (sectionId) {
            showSelectedSection(section, sectionId);
        } else {
            showAllDynamicSections();
        }
    });
</script>

