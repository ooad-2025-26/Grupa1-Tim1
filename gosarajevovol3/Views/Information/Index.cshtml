<script>
    function hideAllDynamicSections() {
        document.querySelectorAll(".transport-display").forEach(section => {
            section.classList.add("hidden-section");
        });

        document.querySelectorAll(".dynamic-info-section").forEach(section => {
            section.classList.add("hidden-section");
        });
    }

    function showSection(event, sectionId) {
        event.preventDefault();
        hideAllDynamicSections();

        const selectedSection = document.getElementById(sectionId);

        if (selectedSection) {
            selectedSection.classList.remove("hidden-section");
            selectedSection.scrollIntoView({
                behavior: "smooth",
                block: "start"
            });
        }
    }

    function showInfoSection(event, sectionId) {
        event.preventDefault();
        hideAllDynamicSections();

        const selectedSection = document.getElementById(sectionId);

        if (selectedSection) {
            selectedSection.classList.remove("hidden-section");
            selectedSection.scrollIntoView({
                behavior: "smooth",
                block: "start"
            });
        }
    }
</script>