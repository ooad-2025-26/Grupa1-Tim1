<link rel="stylesheet" href="~/css/information.css" />

<main class="schedule-page">

    @if (!exists)
    {
        <section class="schedule-not-found">
            <h1>Schedule not found</h1>
            <p>There is no hardcoded schedule for this line yet.</p>
            <p>Key koji se traži: <strong>@key</strong></p>
        </section>
    }
    else
    {
        <section class="schedule-header">
            <a href="/Information" class="back-link">← Back to Information</a>
            <h1>@selectedSchedule.Title</h1>
            <p>@selectedSchedule.Subtitle</p>
        </section>

        <section class="schedule-table-wrapper">
            <table class="schedule-table">
                <thead>
                    <tr>
                        <th>Vrijeme</th>
                        <th>Dani vožnje</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var row in selectedSchedule.Rows)
                    {
                        <tr>
                            <td>@row[0]</td>
                            <td>@row[1]</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }

</main>

@functions {
    public class ScheduleData
    {
        public string Title { get; set; } = "";
        public string Subtitle { get; set; } = "";
        public List<string[]> Rows { get; set; } = new List<string[]>();
    }

    public static List<string[]> MakeRows(string start, string end, int minutes, string days)
    {
        var rows = new List<string[]>();

        var startTime = TimeSpan.Parse(start);
        var endTime = TimeSpan.Parse(end);

        for (var time = startTime; time <= endTime; time = time.Add(TimeSpan.FromMinutes(minutes)))
        {
            rows.Add(new[] { time.ToString(@"hh\:mm"), days });
        }

        return rows;
    }
}