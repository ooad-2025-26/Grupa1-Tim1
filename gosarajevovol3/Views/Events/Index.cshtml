@model IEnumerable<gosarajevovol3.Models.Event>
@using gosarajevovol2.Models.Enums
<link rel="stylesheet" href="~/css/events.css" asp-append-version="true" /> 
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Qwigley&display=swap" rel="stylesheet">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
@{
    ViewData["Title"] = "Sarajevo Events";
    var allFutureEvents = Model.ToList();
}

@if (allFutureEvents.Any())
{
<div class="container-fluid px-0 mb-5" style="overflow: visible !important;">
    <div id="eventsCarousel" class="carousel slide custom-carousel" data-bs-ride="carousel" style="overflow: visible !important;">

        <div class="carousel-indicators">
            @for (int i = 0; i < allFutureEvents.Count; i++)
            {
            <button type="button" data-bs-target="#eventsCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "")"></button>
            }
        </div>

        <div class="carousel-inner custom-carousel-bg" style="overflow: visible !important;">

            <div class="carousel-section-header">
                <h3>What's happening?</h3>
            </div>

            @for (int i = 0; i < allFutureEvents.Count; i++)
            {
                var ev = allFutureEvents[i];
                
                var prikazniNaziv = string.IsNullOrEmpty(ev.EventNameEn) ? ev.EventName : ev.EventNameEn;
                var prikaznaAdresa = string.IsNullOrEmpty(ev.LocationAddressEn) ? ev.LocationAddress : ev.LocationAddressEn;
                var prikazniOpis = string.IsNullOrEmpty(ev.EventDescriptionEn) ? ev.EventDescription : ev.EventDescriptionEn;

                if (!string.IsNullOrEmpty(prikazniOpis) && prikazniOpis.Length > 180)
                {
                    prikazniOpis = prikazniOpis.Substring(0, 180) + "...";
                }

                <div class="carousel-item @(i == 0 ? "active" : "")" style="overflow: visible !important;">
                    <div class="container h-100">
                        <div class="row align-items-center h-100 px-md-5 py-4">

                            <div class="col-md-6 text-white event-info-box">
                                <span class="badge bg-warning text-dark mb-2 text-uppercase">
                                    @(ev.Type.ToString() == "Teatar" || ev.Type.ToString() == "Predstava" ? "Theater" : ev.Type.ToString())
                                </span>

                                <h2 class="fw-bold event-title mb-3">@prikazniNaziv</h2>

                                <p class="event-details">
                                    <i class="bi bi-calendar-event me-2"></i> <strong>Date:</strong> @ev.StartDate.ToString("dd.MM.yyyy") <br />
                                    <i class="bi bi-clock me-2"></i> <strong>Time:</strong>
                                    @if (ev.StartDate.Hour == 0 && ev.StartDate.Minute == 0)
                                    {
                                        <span>TBA</span>
                                    }
                                    else
                                    {
                                        <span>@ev.StartDate.ToString("HH:mm") h</span>
                                    }
                                    <br />
                                    <i class="bi bi-geo-alt me-2"></i> <strong>Location:</strong> @prikaznaAdresa
                                </p>

                                <p class="event-desc d-none d-lg-block mt-3">
                                    @prikazniOpis
                                </p>

                                <a href="@ev.WebUrl" target="_blank" class="btn btn-outline-light mt-3 rounded-pill px-4 fw-bold">
                                    <i class="bi bi-ticket-perforated me-2"></i>Details & Tickets
                                </a>
                            </div>

                            <div class="col-md-6 text-center mt-3 mt-md-0">
                                <div class="event-image-wrapper shadow-lg">
                                    <img src="@(string.IsNullOrEmpty(ev.PhotoUrl) ? "/images/default-event.jpg" : ev.PhotoUrl)"
                                         class="img-fluid event-slider-img"
                                         alt="@prikazniNaziv">
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>

        <button class="carousel-control-prev custom-control" type="button" data-bs-target="#eventsCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next custom-control" type="button" data-bs-target="#eventsCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
</div>
}
else
{
<div class="container text-center my-5 py-5">
    <i class="bi bi-calendar-x display-1 text-muted"></i>
    <h3 class="mt-3">No upcoming events announced at the moment.</h3>
</div>
}
<div class="container mt-5 mb-2">
    <div class="row">
        <div class="col-12 bg-white p-4 shadow-sm rounded">
            <div id="calendar"></div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var calendarEl = document.getElementById('calendar');
        var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            locale: 'en',
            firstDay: 1,  
            aspectRatio: 1.5,
            displayEventTime: false, 
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth' 
            },
            events: '/Events/GetEventsJson', 
            eventClick: function(info) {
                if (info.event.url) {
                    info.jsEvent.preventDefault();
                    window.open(info.event.url, '_blank'); 
                }
            }
        });
        calendar.render();
    });
</script>

<style>
    main,
    .body-content,
    .container,
    .container-fluid {
        max-width: 100% !important;
        width: 100% !important;
    }
    
    html, body {
        height: auto !important;
        min-height: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        overflow-x: hidden !important;
    }

    .custom-carousel, .carousel-inner, .carousel-item {
        overflow: visible !important; 
    }
</style>