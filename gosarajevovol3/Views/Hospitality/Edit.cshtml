@model gosarajevovol3.Models.Hospitality

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Hospitality</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="HospitalityName" class="control-label"></label>
                <input asp-for="HospitalityName" class="form-control" />
                <span asp-validation-for="HospitalityName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="HospitalityDescription" class="control-label"></label>
                <input asp-for="HospitalityDescription" class="form-control" />
                <span asp-validation-for="HospitalityDescription" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PhotoUrl" class="control-label"></label>
                <input asp-for="PhotoUrl" class="form-control" />
                <span asp-validation-for="PhotoUrl" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="HospitalityType" class="control-label"></label>
                <select asp-for="HospitalityType" class="form-control"></select>
                <span asp-validation-for="HospitalityType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LocationAddress" class="control-label"></label>
                <input asp-for="LocationAddress" class="form-control" />
                <span asp-validation-for="LocationAddress" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CoordinatesId" class="control-label"></label>
                <select asp-for="CoordinatesId" class="form-control" asp-items="ViewBag.CoordinatesId"></select>
                <span asp-validation-for="CoordinatesId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="GooglePlaceId" class="control-label"></label>
                <input asp-for="GooglePlaceId" class="form-control" />
                <span asp-validation-for="GooglePlaceId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
