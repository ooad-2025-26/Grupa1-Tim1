@model gosarajevovol3.Models.Hospitality
@using gosarajevovol3.Models.Enums

@{
    Layout = null;
    ViewData["Title"] = "Edit Hospitality Object";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
    <style>
        body { background-color: #f4f7fa; font-family: 'Poppins', sans-serif; }
        .form-container { max-width: 650px; margin: 50px auto; background: #fff; padding: 40px; border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
        .btn-save { background-color: #0c3156; color: white; border-radius: 10px; padding: 12px; font-weight: 600; }
        .btn-save:hover { background-color: #05223f; color: white; }
    </style>
</head>
<body>

<div class="container">
    <div class="form-container">
        
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold m-0" style="color: #0c3156;">Edit Hospitality</h3>
            <a href="/Admin/Dashboard" class="btn btn-outline-secondary btn-sm">Cancel</a>
        </div>

        <form asp-action="EditHospitality" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CoordinatesId" />

            <div class="mb-3">
                <label class="form-label fw-bold">Hospitality Name</label>
                <input asp-for="HospitalityName" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Description</label>
                <textarea asp-for="HospitalityDescription" class="form-control" rows="4" required></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Photo URL</label>
                <input asp-for="PhotoUrl" class="form-control" />
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Hospitality Type</label>
                    <select asp-for="HospitalityType" class="form-select" asp-items="Html.GetEnumSelectList<HospitalityType>()" required></select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Location Address</label>
                    <input asp-for="LocationAddress" class="form-control" required />
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold">Google Place ID (Optional)</label>
                <input asp-for="GooglePlaceId" class="form-control" />
            </div>

            <div class="p-3 bg-light border rounded mb-4">
                <h6 class="fw-bold text-muted mb-3"><i class="fa-solid fa-map-pin me-2 text-danger"></i>Geographical Coordinates</h6>
                <div class="row">
                    <div class="col-6">
                        <label class="form-label small">Latitude</label>
                        <input type="number" step="any" name="latitude" class="form-control" value="@Model.Coordinates?.Latitude" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label small">Longitude</label>
                        <input type="number" step="any" name="longitude" class="form-control" value="@Model.Coordinates?.Longitude" required />
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-save w-100 shadow-sm">
                <i class="fa-solid fa-floppy-disk me-2"></i> Save Changes
            </button>
        </form>
    </div>
</div>

</body>
</html>