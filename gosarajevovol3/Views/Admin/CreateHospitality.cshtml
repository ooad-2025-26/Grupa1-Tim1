@model gosarajevovol3.Models.Hospitality
@using gosarajevovol3.Models.Enums

@{
    Layout = null;
    ViewData["Title"] = "Add New Hospitality Object";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - GoSarajevo</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
    <style>
        body { background-color: #f4f7fa; font-family: 'Poppins', sans-serif; }
        .form-container { max-width: 650px; margin: 50px auto; background: #fff; padding: 40px; border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
        .btn-save { background-color: #0c3156; color: white; border-radius: 10px; padding: 12px; font-weight: 600; }
        .btn-save:hover { background-color: #05223f; color: white; }
    </style>
</head>
<body>

<div class="container">
    <div class="form-container">
        
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold m-0" style="color: #0c3156;">Add Hospitality Object</h3>
            <a href="/Admin/Dashboard" class="btn btn-outline-secondary btn-sm" style="border-radius: 8px;">Cancel</a>
        </div>

        <form asp-action="CreateHospitality" method="post">
            
            <div class="mb-3">
                <label class="form-label fw-bold text-muted">Hospitality Name</label>
                <input asp-for="HospitalityName" class="form-control p-2" style="border-radius: 8px;" placeholder="e.g., Hotel Europe, Ćevabdžinica Željo" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold text-muted">Description</label>
                <textarea asp-for="HospitalityDescription" class="form-control p-2" rows="4" style="border-radius: 8px;" placeholder="Enter details, working hours, ambient info..." required></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold text-muted">Photo URL</label>
                <input asp-for="PhotoUrl" class="form-control p-2" style="border-radius: 8px;" placeholder="e.g., /images/hotel.jpg" />
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold text-muted">Hospitality Type</label>
                    <select asp-for="HospitalityType" class="form-select p-2" style="border-radius: 8px;" asp-items="Html.GetEnumSelectList<HospitalityType>()" required>
                        <option value="">-- Select Type --</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold text-muted">Location Address</label>
                    <input asp-for="LocationAddress" class="form-control p-2" style="border-radius: 8px;" placeholder="e.g., Vladislava Skarića 5" required />
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold text-muted">Google Place ID (Optional)</label>
                <input asp-for="GooglePlaceId" class="form-control p-2" style="border-radius: 8px;" placeholder="For Google Maps API syncing..." />
            </div>

            <div class="p-3 bg-light border rounded mb-4" style="border-radius: 10px;">
                <h6 class="fw-bold text-muted mb-3"><i class="fa-solid fa-map-pin me-2 text-danger"></i>Geographical Coordinates</h6>
                <div class="row">
                    <div class="col-6">
                        <label class="form-label small text-muted">Latitude</label>
                        <input type="number" step="any" name="latitude" class="form-control" placeholder="43.8576" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label small text-muted">Longitude</label>
                        <input type="number" step="any" name="longitude" class="form-control" placeholder="18.4289" required />
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-save w-100 shadow-sm">
                <i class="fa-solid fa-cloud-arrow-up me-2"></i> Save Object
            </button>
        </form>
    </div>
</div>

</body>
</html>