@model gosarajevovol3.Models.Attraction
@using gosarajevovol2.Models.Enums

@{ Layout = null; ViewData["Title"] = "Edit Attraction"; }

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body class="bg-light">
<div class="container my-5">
    <div class="card mx-auto shadow-sm p-4" style="max-width: 700px; border-radius: 16px;">
        
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold m-0" style="color: #0c3156;">Edit Attraction</h3>
            <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">Cancel</a>
        </div>

        <form asp-action="EditAttraction" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CoordinatesId" />

            <div class="mb-3">
                <label class="form-label fw-bold">Attraction Name</label>
                <input asp-for="AttractionName" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Description</label>
                <textarea asp-for="AttractionDescription" class="form-control" rows="4" required></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Photo URL</label>
                <input asp-for="PhotoUrl" class="form-control" />
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Attraction Type</label>
                    <select asp-for="AttractionType" class="form-select" asp-items="Html.GetEnumSelectList<AttractionType>()"></select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Location Address</label>
                    <input asp-for="LocationAddress" class="form-control" required />
                </div>
            </div>

            <div class="p-3 bg-white border rounded mb-4">
                <h6 class="fw-bold text-muted mb-3"><i class="fa-solid fa-map-pin me-2"></i>Geographical Coordinates</h6>
                <div class="row">
                    <div class="col-6">
                        <label class="form-label small">Latitude</label>
                        <input type="number" step="any" name="latitude" class="form-control" value="@Model.Coordinates?.Latitude" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label small">Longitude</label>
                        <input type="number" step="any" name="longitude" class="form-control" value="@Model.Coordinates?.Longitude" required />
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 p-2 fw-bold" style="background-color: #0c3156;">
                <i class="fa-solid fa-floppy-disk me-2"></i> Save Changes
            </button>
        </form>
    </div>
</div>
</body>
</html>