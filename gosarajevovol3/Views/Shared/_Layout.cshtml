<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - gosarajevovol3</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/gosarajevovol3.styles.css" asp-append-version="true"/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Qwigley&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
    <script src="https://kit.fontawesome.com/193845e462.js" crossorigin="anonymous"></script>
</head>
<body style="display:flex; flex-direction:column; min-height:100vh; margin:0;">
<header>
        <nav class="navbar navbar-expand-sm navbar-light navbar-toggleable-sm mb-0"
             style="position: fixed; top: 0; left: 0; right: 0; z-index: 100; background: white;">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/images/GoSarajevoLogo.png" alt="Logo" style="height: 2.75rem; width: auto;">
                <span class = "logo-text text-darkred">Go</span><span class = "logo-text text-darkblue">Sarajevo</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex">
                <ul class="navbar-nav nav-fill w-100 gap-5">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Events</a>
                    </li>
                    <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Visit" asp-action="Index">Visit</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="ThingsToDo" asp-action="Index">Things To Do</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Information</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link smart-button" asp-area="" asp-controller="Home" asp-action="Privacy">Smart Planner</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link log-ikonica" asp-area="" asp-controller="Home" asp-action="Privacy">
                            <i class="fa-solid fa-user fa-lg"></i>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>
    <div class="container-fluid p-0" style="flex:1;">
        <main role="main">
            @RenderBody()
        </main>
</div>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&display=swap" rel="stylesheet">

    <footer class="gs-footer">
        <div class="gs-footer__left">
            <img src="~/images/GoSarajevoLogo.png" alt="GoSarajevo" class="gs-footer__logo" />
            <span style="font-family:'Poppins',sans-serif; color:#ffffff; font-size:1.8rem; margin-left:8px;"><span style="color:#c0392b; font-weight:700;">Go</span><span style="font-weight:700;">Sarajevo</span></span>
        </div>

        <div class="gs-footer__center">
            <p class="gs-footer__contact-title">Contact us!</p>
            <p class="gs-footer__contact-email">info@gosarajevo.ba</p>
        </div>

        <div class="gs-footer__right">
            <span class="gs-footer__quote">Some cities are visited, Sarajevo is felt.</span>
        </div>
    </footer>

    <style>
        .gs-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background-color: #1b3a5c;
        padding: 14px 40px;
        width: 100%;
        box-sizing: border-box;
        flex-shrink: 0;
        }

        .gs-footer__left {
        display: flex;
        align-items: center;
        }

        .gs-footer__logo {
        height: 48px;
        width: auto;
        display: block;
        }

        .gs-footer__center {
        display: flex;
        flex-direction: column;
        align-items: center;
        }

        .gs-footer__contact-title {
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 1rem;
        color: #ffffff;
        margin: 0;
        line-height: 1.4;
        }

        .gs-footer__contact-email {
        font-family: 'Poppins', sans-serif;
        font-weight: 400;
        font-size: 1rem;
        color: #ffffff;
        margin: 0;
        line-height: 1.4;
        }

        .gs-footer__right {
        display: flex;
        align-items: center;
        }

        .gs-footer__quote {
        font-family: 'Qwigley', cursive;
        font-size: 2.8rem;
        color: #ffffff;
        display: inline-block;
        transform: rotate(-3deg);
        transform-origin: center center;
        white-space: nowrap;
        }

        @@media (max-width: 640px) {
        .gs-footer {
        flex-direction: column;
        gap: 12px;
        padding: 20px 24px;
        text-align: center;
        }

        .gs-footer__quote {
        white-space: normal;
        text-align: center;
        }
        }
    </style>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>