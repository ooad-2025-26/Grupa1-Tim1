@model gosarajevovol3.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password - GoSarajevo";
    ViewData["HideFooter"] = true;
}

<div class="login-page-container">
    <div class="login-card text-center" style="position: relative; z-index: 999;">
        <div class="mb-4">
            <div class="logo-wrapper">
                <img src="~/images/GoSarajevoLogo.png" alt="GoSarajevo Logo" class="login-logo" /> 
                <span class="brand-name">
                    Go<span class="bordo">Sarajevo</span>
                </span>
            </div>
            <h1 class="login-title" style="font-size: 2rem;">Reset Password</h1>
            <p class="login-subtitle">Enter your email address and we will send you a link to reset your password.</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success text-start p-2 mb-3" style="border-radius: 12px; font-size: 0.9rem;">
                <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
            </div>
        }

        <form asp-controller="Account" asp-action="ForgotPassword" method="post" style="position: relative; z-index: 1000;">
            @Html.AntiForgeryToken()
            
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger text-start p-2 mb-3" style="border-radius: 12px; font-size: 0.9rem;">
                    <div asp-validation-summary="ModelOnly" class="text-danger list-unstyled m-0"></div>
                </div>
            }

            <div class="mb-4 text-start">
                <label asp-for="Email" class="form-label login-label">Email Address</label>
                <div class="input-group-custom">
                    <span class="input-icon" style="position: absolute; left: 16px; color: #8fa0b5; z-index: 5; pointer-events: none;">
                        <i class="fa-solid fa-envelope"></i>
                    </span>
                    <input asp-for="Email" type="email" class="form-control login-input" placeholder="Enter your registered email" required style="width: 100%; padding: 14px 16px 14px 48px; border: 1px solid #ffffff; border-radius: 12px; background-color: #ffffff;" />
                </div>
                <span asp-validation-for="Email" class="text-danger small ps-2"></span>
            </div>

            <button type="submit" class="btn btn-login w-100 mb-3">Send Reset Link</button>
            
            <div class="text-center">
                <a asp-controller="Account" asp-action="Login" class="login-link fw-semibold text-decoration-underline">Back to Log In</a>
            </div>
        </form>
    </div>
</div>

<style>
    .login-page-container { background: linear-gradient(rgba(255,255,255,0.3), rgba(255,255,255,0.9)), url('../images/slikaSarajevo2.jpg'); background-size: cover; background-position: center; min-height: 100vh; display: flex; justify-content: center; align-items: flex-start; padding-top: 60px; position: relative; z-index: 1; }
    .login-card { background: rgba(203, 218, 233, 0.85); backdrop-filter: blur(8px); border-radius: 24px; padding: 45px 40px; width: 100%; max-width: 520px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08); }
    .login-title { color: #0c3156; font-weight: 700; margin-bottom: 12px; }
    .login-subtitle { color: #3e5871; font-size: 0.95rem; line-height: 1.5; }
    .login-label { color: #0c3156; font-weight: 700; font-size: 0.9rem; margin-bottom: 8px; }
    .input-group-custom { position: relative; display: flex; align-items: center; width: 100%; }
    .login-input:focus { border-color: #0c3156; box-shadow: 0 0 0 3px rgba(12, 49, 86, 0.1); outline: none; }
    .login-link { color: #0c3156; text-decoration: none; font-size: 0.9rem; }
    .btn-login { background-color: #05335e; color: #ffffff; padding: 14px; font-size: 1.1rem; font-weight: 600; border-radius: 12px; border: none; transition: background-color 0.2s ease; }
    .btn-login:hover { background-color: #03213d; color: #ffffff; }
    .logo-wrapper { display: flex; align-items: center; justify-content: center; gap: 12px; }
    .brand-name { font-size: 1.5rem; font-weight: 800; color: #0c3156; }
    .bordo { color: #7b1e2b; }
    .login-logo { max-height: 45px; object-fit: contain; }
</style>