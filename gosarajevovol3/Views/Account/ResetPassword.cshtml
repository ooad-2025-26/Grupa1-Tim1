@model gosarajevovol3.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password - GoSarajevo";
    ViewData["HideFooter"] = true;
}

<div class="login-page-container">
    <div class="login-card text-center" style="position: relative; z-index: 999;">
        <div class="mb-4">
            <div class="logo-wrapper">
                <img src="~/images/GoSarajevoLogo.png" alt="GoSarajevo Logo" class="login-logo" />
                <span class="brand-name">
                    Go<span class="bordo">Sarajevo</span>
                </span>
            </div>
            <h1 class="login-title" style="font-size: 2rem;">Choose New Password</h1>
            <p class="login-subtitle">Please enter your email and set your new password below.</p>
        </div>

        <form asp-controller="Account" asp-action="ResetPassword" method="post" style="position: relative; z-index: 1000;">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Token" />

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger text-start p-2 mb-3" style="border-radius: 12px; font-size: 0.9rem;">
                    <div asp-validation-summary="ModelOnly" class="text-danger list-unstyled m-0"></div>
                </div>
            }

            <div class="mb-3 text-start">
                <label asp-for="Email" class="form-label login-label">Email Address</label>
                <div class="input-group-custom">
                    <span class="input-icon" style="position: absolute; left: 16px; color: #8fa0b5; z-index: 5; pointer-events: none;">
                        <i class="fa-solid fa-envelope"></i>
                    </span>
                    <input asp-for="Email" type="email" class="form-control login-input" readonly style="width: 100%; padding: 14px 16px 14px 48px; border: 1px solid #ffffff; border-radius: 12px; background-color: #e9ecef; color: #6c757d;" />
                </div>
            </div>

            <div class="mb-3 text-start">
                <label asp-for="Password" class="form-label login-label">New Password</label>
                <div class="input-group-custom">
                    <span class="input-icon" style="position: absolute; left: 16px; color: #8fa0b5; z-index: 5; pointer-events: none;">
                        <i class="fa-solid fa-lock"></i>
                    </span>
                    <input asp-for="Password" type="password" class="form-control login-input" placeholder="Enter new password" required style="width: 100%; padding: 14px 16px 14px 48px; border: 1px solid #ffffff; border-radius: 12px; background-color: #ffffff;" />
                </div>
                <span asp-validation-for="Password" class="text-danger small ps-2"></span>
            </div>

            <div class="mb-4 text-start">
                <label asp-for="ConfirmPassword" class="form-label login-label">Confirm Password</label>
                <div class="input-group-custom">
                    <span class="input-icon" style="position: absolute; left: 16px; color: #8fa0b5; z-index: 5; pointer-events: none;">
                        <i class="fa-solid fa-lock"></i>
                    </span>
                    <input asp-for="ConfirmPassword" type="password" class="form-control login-input" placeholder="Confirm new password" required style="width: 100%; padding: 14px 16px 14px 48px; border: 1px solid #ffffff; border-radius: 12px; background-color: #ffffff;" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small ps-2"></span>
            </div>

            <button type="submit" class="btn btn-login w-100 mb-3">Save New Password</button>
        </form>
    </div>
</div>

<style>
    .login-page-container {
        background: linear-gradient(rgba(255,255,255,0.3), rgba(255,255,255,0.9)), url('../images/slikaSarajevo2.jpg');
        background-size: cover;
        background-position: center;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding-top: 60px;
        position: relative;
        z-index: 1;
    }

    .login-card {
        background: rgba(203, 218, 233, 0.85);
        backdrop-filter: blur(8px);
        border-radius: 24px;
        padding: 45px 40px;
        width: 100%;
        max-width: 520px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    }

    .login-title {
        color: #0c3156;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .login-subtitle {
        color: #3e5871;
        font-size: 0.95rem;
        line-height: 1.5;
    }

    .login-label {
        color: #0c3156;
        font-weight: 700;
        font-size: 0.9rem;
        margin-bottom: 8px;
    }

    .input-group-custom {
        position: relative;
        display: flex;
        align-items: center;
        width: 100%;
    }

    .login-input:focus {
        border-color: #0c3156;
        box-shadow: 0 0 0 3px rgba(12, 49, 86, 0.1);
        outline: none;
    }

    .btn-login {
        background-color: #05335e;
        color: #ffffff;
        padding: 14px;
        font-size: 1.1rem;
        font-weight: 600;
        border-radius: 12px;
        border: none;
        transition: background-color 0.2s ease;
    }

        .btn-login:hover {
            background-color: #03213d;
            color: #ffffff;
        }

    .logo-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
    }

    .brand-name {
        font-size: 1.5rem;
        font-weight: 800;
        color: #0c3156;
    }

    .bordo {
        color: #7b1e2b;
    }

    .login-logo {
        max-height: 45px;
        object-fit: contain;
    }
</style>
