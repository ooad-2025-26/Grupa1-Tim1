@{
    ViewData["Title"] = "Password Changed - GoSarajevo";
    ViewData["HideFooter"] = true;
}

<div class="login-page-container">
    <div class="login-card text-center" style="position: relative; z-index: 999;">
        <div class="mb-4">
            <div class="logo-wrapper">
                <img src="~/images/GoSarajevoLogo.png" alt="GoSarajevo Logo" class="login-logo" />
                <span class="brand-name">
                    Go<span class="bordo">Sarajevo</span>
                </span>
            </div>

            <div class="success-icon-wrapper mb-3 mt-4" style="color: #28a745; font-size: 4rem;">
                <i class="fa-solid fa-circle-check"></i>
            </div>

            <h1 class="login-title" style="font-size: 2rem;">Password Changed!</h1>
            <p class="login-subtitle">Your password has been successfully reset. You can now log in with your new password.</p>
        </div>

        <div style="position: relative; z-index: 1000;">
            <a asp-controller="Account" asp-action="Login" class="btn btn-login w-100 mb-2 text-decoration-none d-block">
                Go to Log In
            </a>
        </div>
    </div>
</div>

<style>
    .login-page-container {
        background: linear-gradient(rgba(255,255,255,0.3), rgba(255,255,255,0.9)), url('../images/slikaSarajevo2.jpg');
        background-size: cover;
        background-position: center;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding-top: 60px;
        position: relative;
        z-index: 1;
    }

    .login-card {
        background: rgba(203, 218, 233, 0.85);
        backdrop-filter: blur(8px);
        border-radius: 24px;
        padding: 45px 40px;
        width: 100%;
        max-width: 520px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    }

    .login-title {
        color: #0c3156;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .login-subtitle {
        color: #3e5871;
        font-size: 0.95rem;
        line-height: 1.5;
    }

    .btn-login {
        background-color: #05335e;
        color: #ffffff;
        padding: 14px;
        font-size: 1.1rem;
        font-weight: 600;
        border-radius: 12px;
        border: none;
        transition: background-color 0.2s ease;
        text-align: center;
    }

        .btn-login:hover {
            background-color: #03213d;
            color: #ffffff;
        }

    .logo-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
    }

    .brand-name {
        font-size: 1.5rem;
        font-weight: 800;
        color: #0c3156;
    }

    .bordo {
        color: #7b1e2b;
    }

    .login-logo {
        max-height: 45px;
        object-fit: contain;
    }
</style>