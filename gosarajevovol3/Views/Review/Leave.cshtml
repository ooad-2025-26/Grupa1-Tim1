@model gosarajevovol3.ViewModels.ReviewFormViewModel
@{
    ViewData["Title"] = "Leave a review";
    ViewData["HideFooter"] = true;
}

<style>
    .review-form-page {
        margin-top: 85px;
        display: flex;
        justify-content: center;
        padding: 0 20px 60px;
    }

    .review-form-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 4px 24px rgba(0,0,0,.08);
        padding: 36px 40px;
        width: 100%;
        max-width: 560px;
        font-family: 'Poppins', sans-serif;
    }

    .review-form-title {
        font-size: 1.6rem;
        font-weight: 700;
        color: #1b3a5c;
        margin-bottom: 4px;
    }

    .review-form-sub {
        color: #6b8095;
        font-size: .95rem;
        margin-bottom: 24px;
    }

    .star-input {
        font-size: 2.4rem;
        color: #ccc;
        cursor: pointer;
        user-select: none;
        margin-bottom: 18px;
        display: inline-flex;
        gap: 4px;
    }

        .star-input span.active {
            color: #ffc400;
        }

    .review-textarea {
        width: 100%;
        min-height: 130px;
        border: 1px solid #d4dbe2;
        border-radius: 10px;
        padding: 12px 14px;
        font-family: 'Poppins', sans-serif;
        font-size: .95rem;
        resize: vertical;
        margin-bottom: 8px;
    }

    .review-form-actions {
        display: flex;
        gap: 12px;
        margin-top: 18px;
        flex-wrap: wrap;
    }

    .btn-submit-review {
        background: #d71920;
        color: #fff;
        border: none;
        border-radius: 22px;
        padding: 10px 28px;
        font-weight: 700;
        cursor: pointer;
    }

        .btn-submit-review:hover {
            background: #b9141a;
        }

    .btn-cancel-review {
        background: #eef1f5;
        color: #1b3a5c;
        border-radius: 22px;
        padding: 10px 24px;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

        .btn-cancel-review:hover {
            color: #1b3a5c;
            text-decoration: none;
            opacity: .85;
        }

    .btn-delete-review {
        background: #ffffff;
        color: #d71920;
        border: 1px solid #d71920;
        border-radius: 22px;
        padding: 10px 24px;
        font-weight: 700;
        cursor: pointer;
    }

        .btn-delete-review:hover {
            background: #d71920;
            color: #fff;
        }

    .field-error {
        color: #d71920;
        font-size: .85rem;
        margin-bottom: 10px;
    }
</style>

<div class="review-form-page">
    <div class="review-form-card">
        <h1 class="review-form-title">
            @(Model.ReviewId.HasValue ? "Edit your review" : "Leave a review")
        </h1>
        <p class="review-form-sub">@Model.HospitalityName</p>

        <form asp-controller="Review" asp-action="Leave" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReviewId" />
            <input type="hidden" asp-for="HospitalityId" />
            <input type="hidden" asp-for="HospitalityName" />
            <input type="hidden" asp-for="Rating" id="ratingValue" />

            <div class="star-input" id="starInput">
                <span data-value="1">★</span>
                <span data-value="2">★</span>
                <span data-value="3">★</span>
                <span data-value="4">★</span>
                <span data-value="5">★</span>
            </div>
            <div asp-validation-for="Rating" class="field-error"></div>

            <textarea asp-for="Comment" class="review-textarea"
                      placeholder="Write your comment here..."></textarea>
            <div asp-validation-for="Comment" class="field-error"></div>

            <div class="review-form-actions">
                <button type="submit" class="btn-submit-review">
                    @(Model.ReviewId.HasValue ? "Save changes" : "Post review")
                </button>
                <a asp-controller="ThingsToDo" asp-action="HospitalityDetails"
                   asp-route-id="@Model.HospitalityId" class="btn-cancel-review">Cancel</a>
            </div>
        </form>

        @if (Model.ReviewId.HasValue)
        {
            <form asp-controller="Review" asp-action="Delete" method="post"
                  onsubmit="return confirm('Are you sure you want to delete this review?');"
                  style="margin-top:14px;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.ReviewId" />
                <input type="hidden" name="hospitalityId" value="@Model.HospitalityId" />
                <button type="submit" class="btn-delete-review">Delete review</button>
            </form>
        }
    </div>
</div>

<script>
    (function () {
        var stars = document.querySelectorAll('#starInput span');
        var hidden = document.getElementById('ratingValue');
        var current = parseInt(hidden.value) || 0;

        function paint(val) {
            stars.forEach(function (s) {
                s.classList.toggle('active', parseInt(s.dataset.value) <= val);
            });
        }
        paint(current);

        stars.forEach(function (s) {
            s.addEventListener('mouseenter', function () { paint(parseInt(s.dataset.value)); });
            s.addEventListener('click', function () {
                current = parseInt(s.dataset.value);
                hidden.value = current;
                paint(current);
            });
        });

        document.getElementById('starInput').addEventListener('mouseleave', function () { paint(current); });
    })();
</script>