@{
    ViewData["Title"] = "Home Page";
}

<link rel="stylesheet" href="~/css/home.css" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Qwigley&display=swap" rel="stylesheet">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">

<div class="video-container">
    <video autoplay muted loop playsinline preload="auto" poster="~/images/poster.png" class="hero-video">
        <source src="@ViewBag.SelectedVideo" type="video/mp4">
    </video>
    <div class="explore-overlay">
        <p class="explore-text">EXPLORE MORE</p>
        <div class="explore-arrow">
            <i class="fa-solid fa-arrow-down" style="color: rgb(255, 255, 255);"></i>
        </div>
    </div>
</div>

<div class="main-container">
    <h2>Why visit Sarajevo?</h2>
    <p>
        With its extraordinary <span class="highlight">history</span>, Sarajevo is one of Europe's most captivating hidden gems — a city where Ottoman bazaars and Austro-Hungarian boulevards meet on the same cobblestone street. Visitors from around the world come to discover its iconic <span class="highlight">landmarks and cultural heritage</span>, its legendary <span class="highlight">Bosnian cuisine</span>, and its unmistakable <span class="highlight">warmth and soul</span>.
    </p>
    <p>
        Walking through Sarajevo is not just about sightseeing — it's about feeling the city. It reminds us of merchants trading in the <span class="highlight">Baščaršija</span>, the echo of history at the <span class="highlight">Latin Bridge</span>, and the sight of mosques, churches, and synagogues sharing the same skyline for centuries.
    </p>
    <p>
        Nestled between mountain peaks that hosted the <span class="highlight">1984 Winter Olympics</span>, Sarajevo draws visitors not only for its rich past but for its vibrant, modern spirit — making it one of the most unique and unforgettable destinations in all of Europe.
    </p>
</div>

<div class="activities-section">
    
    <div class="top-activities-badge">
        TOP<br> ACTIVITIES
    </div>
    <div class="cards-container">
        <div class="activity-card">
            <div class="card-image-wrapper">
                <img src="/images/slika2.jpg" alt="Bascarsija" />
            </div>
            <div class="card-title">Baščaršija</div>
            <div class="card-subtitle">Explore the Old Bazaar</div>
        </div>

        <div class="activity-card">
            <div class="card-image-wrapper">
                <img src="/images/slika4.jpg" alt="Cable Car" />
            </div>
            <div class="card-title">Cable Car</div>
            <div class="card-subtitle">Ride to Trebević</div>
        </div>

        <div class="activity-card">
            <div class="card-image-wrapper">
                <img src="/images/slika1.jpg" alt="Vrelo Bosne" />
            </div>
            <div class="card-title">Vrelo Bosne</div>
            <div class="card-subtitle">Discover Nature's Oasis</div>
        </div>

        <div class="activity-card">
            <div class="card-image-wrapper">
                <img src="/images/slika7.jpg" alt="Yellow Bastion" />
            </div>
            <div class="card-title">Yellow Bastion</div>
            <div class="card-subtitle">Catch the Perfect Sunset</div>
        </div>

        <div class="activity-card">
            <div class="card-image-wrapper">
                <img src="/images/slika5.jpg" alt="War Tunnel" />
            </div>
            <div class="card-title">War Tunnel</div>
            <div class="card-subtitle">Uncover Living History</div>
        </div>

        <div class="activity-card">
            <div class="card-image-wrapper">
                <img src="/images/slika3.jpg" alt="Traditional Food" />
            </div>
            <div class="card-title">Traditional Food</div>
            <div class="card-subtitle">Taste Authentic Flavors</div>
        </div>

    </div>
</div>

<style>
    .activities-section {
        position: relative;            
        background-color: #b5c4d2 !important;     
        padding: 80px 20px 40px 20px !important;  
        margin-top: 0px !important;    
        margin-bottom: 0px !important;
        width: 100% !important;
        display: block !important;
    }
    .top-activities-badge {
        position: absolute !important;
        top: -55px !important;                    
        left: 50% !important;                     
        transform: translateX(-50%) !important;   
        width: 120px !important;
        height: 120px !important;
        background-color: #003049 !important;     
        color: white !important;
        border-radius: 50% !important;            
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        text-align: center !important;
        font-family: 'Poppins', sans-serif !important;
        font-weight: 700 !important;
        font-size: 15px !important;
        letter-spacing: 0.5px !important;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15) !important;
        z-index: 10 !important;
    }
    .cards-container {
        display: flex !important;       
        flex-direction: row !important; 
        justify-content: space-between !important; 
        gap: 15px !important;                      
        max-width: 12000px !important;
        margin: 0 auto !important;
        width: 100% !important;
    }
    .activity-card {
        flex: 1 !important;             
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;          
        padding-bottom: 15px !important;
        overflow: hidden !important;
    }
    .card-image-wrapper {
        width: 100% !important;
        aspect-ratio: 2 / 3 !important; 
        background-color: #e2e8f0 !important;     
        overflow: hidden !important;
        border-radius: 6px !important;
    }
    .card-image-wrapper img {
        width: 100% !important;
        height: 100% !important;
        object-fit: cover !important;   
    }
    .card-title {
        padding-top: 12px !important;
        text-align: center !important;
        font-family: 'Poppins', sans-serif !important;
        font-size: 14px !important;
        font-weight: 600 !important;
        color: #003049 !important;                
        text-transform: uppercase !important;     
    }
    .card-subtitle {
        font-family: 'Poppins', sans-serif !important;
        font-size: 13px !important;
        color: #555 !important;
        text-align: center !important;
    }
</style>

<script>
    if (history.scrollRestoration) {
        history.scrollRestoration = 'manual';
    }

    document.addEventListener("DOMContentLoaded", function () {
        const exploreBtn = document.querySelector('.explore-overlay');
        const videoContainer = document.querySelector('.video-container');

        function lock(e) { e.preventDefault(); }
        function lockKeys(e) {
            const keys = ['Space', 'ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End'];
            if (keys.includes(e.code)) e.preventDefault();
        }
        if (window.scrollY > 50) {
            if (videoContainer) {
                videoContainer.style.display = 'none'; 
            }
        } else {
            window.addEventListener('wheel', lock, { passive: false });
            window.addEventListener('touchmove', lock, { passive: false });
            window.addEventListener('keydown', lockKeys, { passive: false });
        }
        exploreBtn.addEventListener('click', function () {
            window.removeEventListener('wheel', lock);
            window.removeEventListener('touchmove', lock);
            window.removeEventListener('keydown', lockKeys);

            videoContainer.classList.add('slide-up-smooth');

            setTimeout(() => {
                videoContainer.style.display = 'none';
                window.scrollTo(0, 0);
            }, 600);
        });
    });
</script>